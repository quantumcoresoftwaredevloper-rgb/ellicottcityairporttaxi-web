# Social login — enables the "Continue with Google" / "Continue with Facebook"
# buttons on Login and Register. Without these, the buttons still show but
# display a notice when clicked.
#
# Google: create an OAuth 2.0 Client ID (Web application) at
#   https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: http://localhost:5001/api/auth/google/callback
# Facebook: create a Facebook App at https://developers.facebook.com and add the
#   "Facebook Login for Business" product. Authorized redirect URI:
#   http://localhost:5001/api/auth/facebook/callback
#
# You must ALSO set the matching secrets server-side (GOOGLE_CLIENT_ID +
# GOOGLE_CLIENT_SECRET / FACEBOOK_APP_ID + FACEBOOK_APP_SECRET) in server/.env.
VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_APP_ID=

# Absolute API origin. REQUIRED for production builds: vercel.json rewrites
# every path to index.html, so a same-origin "/api/..." request returns the HTML
# shell instead of JSON and the app silently breaks. Vercel injects this at
# build time; set it here for local `vite build` so the bundle is not broken.
# Leave blank only if you run `npm run dev`, which proxies /api to the backend.
VITE_API_URL=https://ridetaxi-api.onrender.com

# Stripe - real online card payments. Public publishable key (safe to expose).
# The matching secret lives in server/.env as STRIPE_SECRET_KEY.
VITE_STRIPE_PUBLISHABLE_KEY=
