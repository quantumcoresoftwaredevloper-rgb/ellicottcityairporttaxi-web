PORT=5001
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/ellicottaxi

# Access tokens are signed with this secret. Generate a real one for production,
# e.g. `openssl rand -hex 32`. The server refuses to boot in production if this
# is a placeholder or shorter than 32 characters.
JWT_ACCESS_SECRET=change-me-access-secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
REMEMBER_ME_EXPIRY=30d
CLIENT_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# CORS allowlist for ADDITIONAL trusted frontends, comma-separated. Use this
# rather than adding to CLIENT_ORIGIN, because CLIENT_ORIGIN is also the base
# URL for verification/reset links in outgoing email and must stay a single
# origin. The native Capacitor app (capacitor://localhost on iOS,
# http://localhost on Android) is always allowed and does not need to be listed.
#
# Local: this lets you run the web app on 5173 and the Capacitor app's UI on 5174
# at the same time. Outside production, http://localhost and http://127.0.0.1 are
# also treated as equivalents, so either spelling works.
# CORS_ORIGINS=https://staging.example.com,https://preview.example.com
CORS_ORIGINS=http://localhost:5174

# Optional. When set, rate-limit counters are kept in Redis so the limits are
# enforced across every instance. Without it each process keeps its own counters.
# REDIS_URL=redis://localhost:6379

# Development only. When 'true', password-reset / email-verification links and
# the SMS fallback code are returned in API responses so they can be tested
# without a mail/SMS provider. MUST be unset in production — it is a full
# account-takeover primitive. The server refuses to boot if it is 'true'.
# EXPOSE_DEV_TOKENS=true

# Production hardening
TRUST_PROXY=false            # true when behind nginx/Render/Vercel (correct client IP)
RATE_LIMIT_API=600           # requests / 15 min per IP (global API)
RATE_LIMIT_AUTH=60           # requests / 15 min per IP (auth endpoints)
RATE_LIMIT_LOGIN=10          # login attempts / 15 min per IP (dev default: 100, prod: 10)
RATE_LIMIT_OTP=5             # SMS codes / 10 min per IP

# Email (SMTP) - optional. If unset, emails are logged to the console (dev only).
# Gmail example (free, no extra account):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=<your-gmail-address>
#   SMTP_PASS=<16-char Gmail App Password, NOT your normal password>
#   SMTP_FROM=Ellicott City Airport Taxi <your-gmail-address>
# Create an App Password at https://myaccount.google.com/apppasswords (needs
# 2-Step Verification enabled on the account).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Social login - Passport OAuth2 redirect flow. Omit to disable the strategy.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=         # default: {APP_URL}/api/auth/google/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=       # default: {APP_URL}/api/auth/facebook/callback

# Phone OTP (SMS) - optional. Without these, codes are logged to the console and
# returned as devCode so the flow works in development.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=

# Web push notifications - optional. Generate keys with:
#   npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:chriskbonsu@gmail.com

# Stripe - real online card payments. When STRIPE_SECRET_KEY is set, card
# payments go through Stripe Payment Intents; otherwise the app falls back to
# the sandbox card simulator (card ending 0002 declines). Set the publishable
# key in client/.env as VITE_STRIPE_PUBLISHABLE_KEY.
STRIPE_SECRET_KEY=
# The Payment Method Domain id (pmd_...) is informational only and is NOT read
# by the server. Do not pass it as `payment_method_configuration` — that
# parameter needs a Payment Method Configuration id (pmc_...).
